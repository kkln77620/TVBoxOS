<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 可滚动内容区: 底部预留返回按钮空间 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/vs_70"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/vs_40">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_40"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:textColor="@color/color_FFFFFF_70"
        android:textSize="@dimen/ts_22" />

    <!-- 定位 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_30"
        android:text="【软件定位】"
        android:textColor="@color/color_FFB800"
        android:textSize="@dimen/ts_24"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:lineSpacingExtra="@dimen/vs_8"
        android:text="面向安卓电视/盒子的多功能影视聚合播放器，聚合多数据源、多配置地址，集点播、直播、搜索、收藏于一体，适配遥控器与触屏双操作模式。"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />

    <!-- 主要功能 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_25"
        android:text="【主要功能】"
        android:textColor="@color/color_FFB800"
        android:textSize="@dimen/ts_24"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:lineSpacingExtra="@dimen/vs_8"
        android:text="· 六大板块导航：主页 / 分类 / 搜索 / 收藏 / 历史 / 设置\n· 多配置地址管理：可同时启用多个配置，数据源按配置分组\n· 主页配置一键切换：指定任一配置作为主页数据源\n· 聚合搜索：多源搜索结果按名称/年份智能合并，详情页可切换数据源\n· 直播播放：触屏控制台一键切换频道\n· 视频壁纸：内置壁纸循环切换，支持上传图片作为壁纸"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />

    <!-- 检测更新 -->
    <TextView
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_25"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:background="@drawable/button_dialog_main"
        android:focusable="true"
        android:text="检测更新"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />

    <!-- 源码地址 -->
    <TextView
        android:id="@+id/tvSourceUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_35"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:background="@drawable/button_dialog_main"
        android:focusable="true"
        android:text="源码地址: https://github.com/kkln77620/TVBoxOS"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部固定返回按钮 -->
    <TextView
        android:id="@+id/btnBackAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/vs_40"
        android:layout_marginRight="@dimen/vs_40"
        android:layout_marginBottom="@dimen/vs_20"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:background="@drawable/button_dialog_vod"
        android:focusable="true"
        android:text="返回"
        android:textColor="@color/color_FFB800"
        android:textSize="@dimen/ts_22" />
</FrameLayout>