<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_50"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15">

        <TextView
            android:id="@+id/webBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textColor="#FFB800"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/webTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="外链"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <ProgressBar
            android:id="@+id/webProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>