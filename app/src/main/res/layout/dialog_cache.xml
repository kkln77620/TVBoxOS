<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivCachePic"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_15"
            android:layout_marginLeft="@dimen/vs_15"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCacheTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_5"
                android:text="点击集数开始缓存, 弹窗不会关闭"
                android:textColor="@color/color_FFFFFF_70"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:text="画质"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <LinearLayout
        android:id="@+id/bwRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:text="线路"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/flagRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:text="选集"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/epList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />
</LinearLayout>
