<?xml version="1.0" encoding="utf-8"?>
<!-- 弹幕地址输入对话框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="弹幕地址"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_28"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:text="片源未提供弹幕时使用此地址加载弹幕"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_20" />

    <EditText
        android:id="@+id/inputDanmuUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/input_dialog_api_input"
        android:hint="弹幕接口地址，留空表示不启用"
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="@dimen/vs_10"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_30"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDanmuCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_50"
            android:layout_marginRight="@dimen/vs_5"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main"
            android:gravity="center"
            android:text="取消"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnDanmuSave"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_5"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main"
            android:gravity="center"
            android:text="保存"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
