<?xml version="1.0" encoding="utf-8"?>
<!-- 首次使用手册 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_600"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="📖 使用手册"
        android:textColor="@color/color_FFB800"
        android:textSize="@dimen/ts_30"
        android:textStyle="bold"
        android:paddingBottom="@dimen/vs_15" />

    <TextView
        android:id="@+id/manualContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/vs_8"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/btnManualKnow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/button_dialog_main"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_12"
        android:text="知道了"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22" />
</LinearLayout>