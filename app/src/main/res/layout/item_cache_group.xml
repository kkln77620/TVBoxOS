<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_setting_model_focus"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/vs_12">

    <ImageView
        android:id="@+id/ivGroupPic"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:adjustViewBounds="false"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_15"
        android:layout_marginLeft="@dimen/vs_15"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/tvGroupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGroupState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_10"
        android:layout_marginLeft="@dimen/vs_10"
        android:textColor="@color/color_FFB800"
        android:textSize="@dimen/ts_18" />
</LinearLayout>